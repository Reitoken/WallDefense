            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "UE: Rebuild Editor",
            "type": "shell",
            "command": "& \"${env:UE_ROOT}\\Engine\\Build\\BatchFiles\\Rebuild.bat\" WallDefenseEditor Win64 Development -project=\"${workspaceFolder}\\WallDefense\\WallDefense.uproject\" -waitmutex",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
