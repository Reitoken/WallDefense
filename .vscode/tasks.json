        {
            "label": "UE: Open Editor",
            "type": "shell",
            "command": "Start-Process \"${env:UE_ROOT}\\Engine\\Binaries\\Win64\\UnrealEditor.exe\" -ArgumentList '\"${workspaceFolder}\\WallDefense\\WallDefense.uproject\"'",
            "problemMatcher": [],
