{
    "version": "2.0.0",
    "options": {
        "env": {
            "UE_ROOT": "C:\\Unreal Engine\\UE_5.7"
        }
    },
    "tasks": [
        {
            "label": "UE: Build Editor (Development)",
            "type": "shell",
            "command": "& \"${env:UE_ROOT}\\Engine\\Build\\BatchFiles\\Build.bat\" WallDefenseEditor Win64 Development -project=\"${workspaceFolder}\\WallDefense\\WallDefense.uproject\" -waitmutex",
            "group": {
                "kind": "build",
